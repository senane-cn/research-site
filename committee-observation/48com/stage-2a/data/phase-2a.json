  "countries": [
    { "id": "armenia", "code": "ARM", "name_zh": "亚美尼亚", "name_en": "Armenia", "region": "europe_north_america", "profile": "跨区域文本支持与实施期判断", "summary": "在Hampi正式共同文本和Ohrid现场支持中参与明显，同时在程序延会、冲突遗产与实施时限之间保持较宽覆盖。" },
    { "id": "azerbaijan", "code": "AZE", "name_zh": "阿塞拜疆", "name_en": "Azerbaijan", "region": "europe_north_america", "profile": "程序启动与自然遗产共同文本", "summary": "主导Kosovo延会动议，并与坦桑尼亚联合提交Sundarbans修正；参与集中在程序、公平审议和自然遗产累积影响。" },
    { "id": "bangladesh", "code": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh", "region": "asia_pacific", "profile": "程序坚持与伦敦文本主提", "summary": "在Vienna程序争论中要求严格执行议事规则；主提Westminster修正并多次协调任务、HIA和报告期限；Sundarbans发言按缔约国角色另列。" },
    { "id": "czechia", "code": "CZE", "name_zh": "捷克", "name_en": "Czechia", "region": "europe_north_america", "profile": "证据、程序与文本校准者", "summary": "从报告可比性、遥感证据到伦敦规划工具和复审周期持续介入；在Victoria Falls讨论中请IUCN澄清生态连通性与突出普遍价值陈述的依据。" },
    { "id": "grenada", "code": "GRD", "name_zh": "格林纳达", "name_en": "Grenada", "region": "latin_caribbean", "profile": "时限折衷与现场共同支持", "summary": "在Westminster形成两阶段报告折衷，并在Hampi、Chiloé、Ohrid及Pinacate中支持更可实施的文本与任务安排。" },
    { "id": "jamaica", "code": "JAM", "name_zh": "牙买加", "name_en": "Jamaica", "region": "latin_caribbean", "profile": "高频文本协调与加勒比保护视角", "summary": "主提Tower修正、参与Westminster和Chiloé协商，并在Paramaribo列危后补充加勒比支持，是本阶段提出端与讨论端同时活跃的成员。" },
    { "id": "kazakhstan", "code": "KAZ", "name_zh": "哈萨克斯坦", "name_en": "Kazakhstan", "region": "asia_pacific", "profile": "任务优先与延期程序推动", "summary": "以Baikal延期动议形成最清晰程序结果；在Hampi与Ohrid强调先取得任务或实施证据，再作更强保护决定。" },
    { "id": "kenya", "code": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya", "region": "africa", "profile": "共同文本主导与列入标准边界", "summary": "与塞内加尔、多哥、坦桑尼亚共同提交Victoria Falls文本，并以4次发言推动按列入标准限定管理要求，最终保留地貌属性、删除生态连通性措辞。" },
    { "id": "kuwait", "code": "KWT", "name_zh": "科威特", "name_en": "Kuwait", "region": "arab", "profile": "低频但具正式共同文本", "summary": "口头发言集中在Vienna程序、Hampi与Tyre；通过Hampi正式共同提出形成清晰文本参与，Baikal表决选择弃权。" },
    { "id": "lebanon", "code": "LBN", "name_zh": "黎巴嫩", "name_en": "Lebanon", "region": "arab", "profile": "HIA与程序护栏", "summary": "反复追问事前HIA、任务性质和修正案时限；Tyre的两次发言作为遗产所在缔约国答辩单列，不与讨论影响混算。" },
    { "id": "mongolia", "code": "MNG", "name_zh": "蒙古", "name_en": "Mongolia", "region": "asia_pacific", "profile": "生态系统与跨境水文回应", "summary": "在Ohrid和Chiloé支持实施型文本；Baikal后续回应聚焦额金河项目评估及俄蒙跨境合作，反映自然系统连通性关注。" },
    { "id": "peru", "code": "PER", "name_zh": "秘鲁", "name_en": "Peru", "region": "latin_caribbean", "profile": "文本主提与程序性延期", "summary": "主提Chiloé修正并解释影响评估范围；在Península Valdés提出休止辩论，形成等待新技术材料的程序结果。" },
    { "id": "poland", "code": "POL", "name_zh": "波兰", "name_en": "Poland", "region": "europe_north_america", "profile": "高保护门槛与生态属性倡议", "summary": "在冲突遗产、Baikal和伦敦两案支持较强监督；在Victoria Falls以5次发言主张保留生态连通性，随后为形成共识接受不含该词的折衷文本。" },
    { "id": "republic_of_korea", "code": "KOR", "name_zh": "大韩民国", "name_en": "Republic of Korea", "region": "asia_pacific", "profile": "报告周期与任务衔接审查", "summary": "国家代表团发言主要核对Hampi、Ohrid和Sundarbans的报告时点、任务逻辑与社区效益；主席制度身份行动全部剔除。" },
    { "id": "senegal", "code": "SEN", "name_zh": "塞内加尔", "name_en": "Senegal", "region": "africa", "profile": "非洲共同文本与合作性列危工具", "summary": "共同提出Hampi与Victoria Falls文本，支持Tyre列危作为援助工具，并在Victoria Falls逐段审议中以口头发言支持列入标准导向的共同文本。" },
    { "id": "switzerland", "code": "CHE", "name_zh": "瑞士", "name_en": "Switzerland", "region": "europe_north_america", "profile": "科学严谨与高密度讨论介入", "summary": "在报告科学质量、HIA、任务类型和复审时限上持续发言；在Victoria Falls引用鸟类与森林属性支持生态连通性，同时接受最终共识文本。" },
    { "id": "togo", "code": "TGO", "name_zh": "多哥", "name_en": "Togo", "region": "africa", "profile": "非洲共同文本与程序共识", "summary": "共同提出Hampi与Victoria Falls文本，在Ohrid、Kosovo和Vienna程序中支持协作性处理，Baikal后提出程序说明。" },
    { "id": "turkiye", "code": "TUR", "name_zh": "土耳其", "name_en": "Türkiye", "region": "europe_north_america", "profile": "Ohrid议程设置与跨个案高覆盖", "summary": "主提Ohrid修正并推动以承诺、任务和延后复审替代本届列危；同时广泛参与冲突遗产、伦敦规划与程序议题。" },
    { "id": "ukraine", "code": "UKR", "name_zh": "乌克兰", "name_en": "Ukraine", "region": "europe_north_america", "profile": "冲突遗产与列危立场", "summary": "主提Vienna修正并推动延会；在Tauric Chersonese以缔约国身份答辩，在Baikal反复支持立即列危，形成鲜明证据与保护门槛立场。" },
    { "id": "tanzania", "code": "TZA", "name_zh": "坦桑尼亚联合共和国", "name_en": "United Republic of Tanzania", "region": "africa", "profile": "高覆盖共同文本与标准边界", "summary": "共同提出Hampi、Chiloé、Sundarbans和Victoria Falls文本；在Victoria Falls强调列入标准与执行责任边界，反对以生态术语扩大正式义务。" },
    { "id": "viet_nam", "code": "VNM", "name_zh": "越南", "name_en": "Viet Nam", "region": "asia_pacific", "profile": "Hampi文本主提与合作性措辞", "summary": "主提Hampi修正，围绕措辞强度、HIA义务和两层报告安排多次回应；也参与Kosovo、Vienna及Tyre等项目。" }
